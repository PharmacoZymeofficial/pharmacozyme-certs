# ============================================================
# PharmacoZyme Certificate System — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to GitHub!
# ============================================================

# Your deployed app URL (Vercel gives you this after deploy)
# e.g. https://pharmacozyme-certs.vercel.app
NEXT_PUBLIC_BASE_URL=https://your-vercel-app.vercel.app

# Verification portal URL (usually BASE_URL + /verify)
NEXT_PUBLIC_VERIFY_URL=https://your-vercel-app.vercel.app/verify

# ── Firebase Configuration (client SDK — public by design) ──
# Get these from Firebase Console → Project Settings → Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Firebase Admin SDK (server-only — required) ──────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Base64-encode the downloaded JSON file before pasting it here (the private key's
# newlines do not survive .env files or the Vercel dashboard reliably):
#   node -e "console.log(require('fs').readFileSync('service-account.json').toString('base64'))"
# Without this, every API route that touches Firestore will throw at request time —
# there is no fallback to the (now locked-down) client SDK.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Session signing (required) ───────────────────────────────
# Signs the admin session cookie (HMAC-SHA256). Generate a random 48+ byte secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates every existing admin session.
SESSION_SECRET=

# ── Email Service (Resend) ──────────────────────────────────
# Get from resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# Set to "true" only in local development to allow a send to "succeed" as a simulated,
# non-delivered send when no email provider is configured. Never set this in production —
# it is what previously let scheduled emails get marked "sent" while delivering nothing.
ALLOW_SIMULATED_EMAIL=false

# ── Brevo (per-sender API keys) ──────────────────────────────
BREVO_API_KEY_PHARMACOZYME=
BREVO_API_KEY_ACADEMY=

# ── Google Drive Folder ID ──────────────────────────────────
# The folder ID from your Google Drive URL where PDFs are saved
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# ── Google Apps Script ──────────────────────────────────────
# Deploy apps-script.js as a Web App in Google Apps Script
# and paste the deployment URL here
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Shared secret the Next.js app sends with every Apps Script call. Set the same value
# in the Apps Script project's Script Properties (key: APPS_SCRIPT_SECRET) — see
# apps-script.js's isAuthorized(). The Apps Script web app must be deployed with access
# "Anyone" to be reachable at all, so this secret is what actually authenticates it;
# without it, anyone who learns the deployment URL can write to your Sheets and Drive.
APPS_SCRIPT_SECRET=

# ── Admin ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@pharmacozyme.com

# Vercel Cron auth for /api/cron/send-scheduled, and also accepted by /api/send-email
# as the internal-call credential the scheduled-email runner uses. Required — an unset
# value now makes the cron endpoint refuse all requests rather than allow all requests.
CRON_SECRET=
